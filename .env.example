# 来源：Google AI Studio (https://aistudio.google.com/apikey)
# 轮换方式：在 AI Studio API Keys 页面撤销旧 Key 并重新生成
# 建议：可放在本项目 .env 或 ~/.env（demos/common.py 会按 env > 项目 .env > ~/.env 顺序加载）
# 注意：不要将真实的 .env 提交到 git！

GEMINI_API_KEY=your_gemini_api_key_here

# 可选：用于管理 GCP $10/月开发者抵用金项目（通过 gcloud CLI 使用）
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
